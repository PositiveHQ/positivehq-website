# Public URL for canonical links, metadata, and webhooks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key used by browser-safe read operations
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key for privileged server operations.
# Never expose this key in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lead notification email delivery. Resend is used server-side only.
RESEND_API_KEY=your-resend-api-key
LEADS_FROM_EMAIL=Positive Watch HQ <leads@positivewatchhq.com>
LEADS_TO_EMAIL=nick@mrpositivehq.com
LEADS_CC_EMAIL=robert@positivewatchhq.com

# Temporary admin portal password for internal operators.
# Phase 4 should replace this with hardened auth (Supabase Auth / SSO).
ADMIN_PORTAL_PASSWORD=change-this-admin-password

# Secret used to sign admin cookie sessions.
# Use a long random value in production.
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# Public Supabase storage bucket for watch images.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=watch-images

# Sanity CMS config (Phase 5 blog CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: token for reading private/draft content server-side.
SANITY_API_READ_TOKEN=
